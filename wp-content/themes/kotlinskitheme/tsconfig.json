{
  "compilerOptions": {
    "target": "ES5", // Set the target JavaScript version
    "module": "ESNext",
    "outDir": "./js", // Output folder for compiled JS files
    "jsx": "react-jsx",
    "strict": true, // Enable strict type-checking
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node"
  }
}
