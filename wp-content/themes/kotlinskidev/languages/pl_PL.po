#: build/project-card.js:1
msgid "(no title)"
msgstr "(brak tytułu)"

#: build/article-card.js:1
msgid "Manage the card's linked article, image, and text from Article Cards in the admin menu. Editing the shared card layout there updates every card wherever it's embedded."
msgstr "Zarządzaj powiązanym artykułem, obrazem i tekstem karty w menu Karty artykułów w panelu administracyjnym. Edycja wspólnego układu karty aktualizuje każdą kartę, gdziekolwiek jest osadzona."

#: build/article-card-panel.js:1
msgid "Linked Article"
msgstr "Powiązany artykuł"

#: build/article-card-panel.js:1
msgid "Picking an article fills this card's image, text, and link. Card layout, colors, and typography are edited once for every card via the Site Editor template."
msgstr "Wybór artykułu wypełnia obraz, tekst i link tej karty. Układ, kolory i typografia karty są edytowane jednorazowo dla wszystkich kart w szablonie Edytora Strony."

#: build/article-card-panel.js:1
msgid "Card description (optional)"
msgstr "Opis karty (opcjonalnie)"

#: build/article-card-panel.js:1
msgid "Leave empty to use the article's title."
msgstr "Pozostaw puste, aby użyć tytułu artykułu."

#: build/project-card.js:1
msgid "Manage the card's image, description, tags, and link from Project Cards in the admin menu. Editing the shared card layout there updates every card wherever it's embedded."
msgstr "Zarządzaj obrazem, opisem, tagami i linkiem karty w menu Karty projektów w panelu administracyjnym. Edycja wspólnego układu karty aktualizuje każdą kartę, gdziekolwiek jest osadzona."

#: build/project-card-panel.js:1
msgid "Project Details"
msgstr "Szczegóły projektu"

#: build/project-card-panel.js:1
msgid "Description (hover overlay text)"
msgstr "Opis (tekst nakładki po najechaniu)"

#: build/project-card-panel.js:1
msgid "Shown as overlay text when hovering the card image."
msgstr "Wyświetlany jako tekst nakładki po najechaniu na obraz karty."

#: build/project-card-panel.js:1
msgid "Space-separated, e.g. \"WordPress Elementor Yoast SEO\"."
msgstr "Oddzielone spacjami, np. \"WordPress Elementor Yoast SEO\"."

#: build/project-card-panel.js:1
msgid "Project URL"
msgstr "Adres URL projektu"

#: build/project-card-panel.js:1
msgid "Where the arrow icon links to."
msgstr "Dokąd prowadzi ikona strzałki."

