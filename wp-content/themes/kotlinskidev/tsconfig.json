{
	"compilerOptions": {
		"outDir": "./build/",
		"sourceMap": true,
		"strict": true,
		"noImplicitReturns": true,
		"noImplicitAny": true,
		"module": "es6",
		"moduleResolution": "node",
		"target": "es5",
		"allowJs": true,
		"lib": ["DOM", "ESNext"],
		"jsx": "react",
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./src",
		"paths": {
			"@utils/*": ["utils/*"]
		}
	},
	"include": ["./src/**/*"]
}