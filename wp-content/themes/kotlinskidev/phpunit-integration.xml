<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="tests/integration/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/integration/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Integration">
            <directory suffix="Test.php">./tests/integration/tests</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist>
            <directory>functions</directory>
            <directory>includes</directory>
            <directory suffix="render.php">src/blocks</directory>
            <exclude>
                <file>functions/seo-customizer.php</file>
            </exclude>
        </whitelist>
    </filter>
</phpunit>
