{
  "mcpServers": {
    "wordpress-local": {
      "type": "http",
      "url": "http://kotlinskidev.local/wp-json/mcp/mcp-adapter-default-server",
      "headers": {
        "Authorization": "Bearer ${WP_MCP_API_KEY}"
      }
    },
    "wordpress-prod": {
      "type": "http",
      "url": "https://kotlinskidev.com/wp-json/mcp/mcp-adapter-default-server",
      "headers": {
        "Authorization": "Bearer ${WP_MCP_API_KEY_PROD}"
      }
    },
    "lighthouse": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "lighthouse-mcp"
      ],
      "env": {}
    },
    "chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "deployhq": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "deployhq-mcp-server"],
      "env": {
        "DEPLOYHQ_EMAIL": "${DEPLOYHQ_EMAIL}",
        "DEPLOYHQ_API_KEY": "${DEPLOYHQ_API_KEY}",
        "DEPLOYHQ_ACCOUNT": "${DEPLOYHQ_ACCOUNT}"
      }
    }
  }
}