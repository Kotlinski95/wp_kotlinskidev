{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.scss", "*.css"],
      "options": {
        "useTabs": true,
        "printWidth": 500
      }
    }
  ]
}
