{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/blog-topics-grid-dynamic",
  "version": "1.0.0",
  "title": "Blog Topics Grid (Dynamic)",
  "category": "kotlinskidev",
  "description": "Server-rendered grid of blog category topics, refreshed per language.",
  "icon": "grid-view",
  "textdomain": "kotlinskidev",
  "render": "file:./render.php",
  "editorScript": "file:../../../build/js/blog-topics-grid-dynamic.js",
  "attributes": {
    "cardTextColor": { "type": "string", "default": "" },
    "cardBorderColor": { "type": "string", "default": "" },
    "cardBackgroundColor": { "type": "string", "default": "" },
    "buttonBackgroundColor": { "type": "string", "default": "" },
    "buttonTextColor": { "type": "string", "default": "" },
    "buttonHoverBackgroundColor": { "type": "string", "default": "" },
    "buttonHoverTextColor": { "type": "string", "default": "" },
    "cardHoverBackgroundColor": { "type": "string", "default": "" },
    "blurOtherCards": { "type": "boolean", "default": false },
    "blurAmount": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}
