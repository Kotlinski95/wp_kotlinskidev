{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/canvas-layer-sweep",
  "version": "1.0.0",
  "title": "Canvas Layer: Sweep",
  "category": "kotlinskidev",
  "icon": "art",
  "description": "A diagonal light-sweep layer for a Canvas Scene.",
  "textdomain": "kotlinskidev",
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "inserter": true
  },
  "attributes": {
    "speed": { "type": "number", "default": 0.15 },
    "angleDeg": { "type": "number", "default": 25 },
    "width": { "type": "number", "default": 0.15 },
    "color": { "type": "string", "default": "#ffffff" }
  }
}
