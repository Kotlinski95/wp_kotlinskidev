{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/canvas-layer-gradient",
  "version": "1.0.0",
  "title": "Canvas Layer: Gradient",
  "category": "kotlinskidev",
  "icon": "art",
  "description": "A background-gradient layer for a Canvas Scene.",
  "textdomain": "kotlinskidev",
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "inserter": true
  },
  "attributes": {
    "colorStart": { "type": "string", "default": "var(--wp--preset--color--primary)" },
    "colorEnd": { "type": "string", "default": "var(--wp--preset--color--surface)" },
    "angleDeg": { "type": "number", "default": 135 },
    "speed": { "type": "number", "default": 0.2 }
  }
}
