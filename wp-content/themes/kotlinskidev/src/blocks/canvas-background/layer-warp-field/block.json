{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/canvas-layer-warp-field",
  "version": "1.0.0",
  "title": "Canvas Layer: Warp Field",
  "category": "kotlinskidev",
  "icon": "art",
  "description": "A procedural, slowly-rotating 3D star field with a breathing zoom for a Canvas Scene.",
  "textdomain": "kotlinskidev",
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "inserter": true
  },
  "attributes": {
    "speed": { "type": "number", "default": 1 },
    "density": { "type": "number", "default": 1 },
    "color": { "type": "string", "default": "var(--wp--preset--color--foreground)" },
    "opacity": { "type": "number", "default": 1 }
  }
}
