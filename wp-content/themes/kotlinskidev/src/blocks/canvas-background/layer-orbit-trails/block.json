{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/canvas-layer-orbit-trails",
  "version": "1.0.0",
  "title": "Canvas Layer: Orbit Trails",
  "category": "kotlinskidev",
  "icon": "art",
  "description": "A pulsing, color-cycling orbit with fading feedback trails for a Canvas Scene.",
  "textdomain": "kotlinskidev",
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "inserter": true
  },
  "attributes": {
    "speed": { "type": "number", "default": 1 },
    "decay": { "type": "number", "default": 0.986 },
    "color": { "type": "string", "default": "var(--wp--preset--color--foreground)" },
    "opacity": { "type": "number", "default": 1 }
  }
}
