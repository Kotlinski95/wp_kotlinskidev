{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/nav-banner",
  "version": "1.0.0",
  "title": "Nav Banner",
  "category": "kotlinskidev-navigation",
  "icon": "align-center",
  "description": "Banner with media image and content for navigation panels.",
  "textdomain": "kotlinskidev",
  "editorScript": "file:../../../build/js/nav-content.js",
  "render": "file:./render.php",
  "attributes": {
    "mediaId": { "type": "integer", "default": 0 },
    "mediaUrl": { "type": "string", "default": "" },
    "altText": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "description": { "type": "string", "default": "" },
    "linkUrl": { "type": "string", "default": "" },
    "linkLabel": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": false
    },
    "spacing": {
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    }
  }
}
