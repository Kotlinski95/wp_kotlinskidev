exports[`gallery-lightbox save markup every setting 1`] = `"<div class="wp-block-x" data-gallery-lightbox="" data-images="[{&quot;src&quot;:&quot;a.jpg&quot;,&quot;alt&quot;:&quot;A photo&quot;,&quot;type&quot;:&quot;image&quot;,&quot;poster&quot;:&quot;&quot;,&quot;width&quot;:10,&quot;height&quot;:20},{&quot;src&quot;:&quot;a.jpg&quot;,&quot;alt&quot;:&quot;A photo&quot;,&quot;type&quot;:&quot;video&quot;,&quot;poster&quot;:&quot;q.jpg&quot;,&quot;width&quot;:0,&quot;height&quot;:0}]" data-mobile-images="[{&quot;src&quot;:&quot;n.jpg&quot;,&quot;alt&quot;:&quot;A photo&quot;,&quot;type&quot;:&quot;image&quot;,&quot;poster&quot;:&quot;&quot;,&quot;width&quot;:0,&quot;height&quot;:0}]" data-settings="{&quot;showArrows&quot;:true,&quot;showPagination&quot;:false,&quot;loop&quot;:true,&quot;autoplay&quot;:true,&quot;autoplayDelay&quot;:2500,&quot;slidesPerView&quot;:1,&quot;lazyLoad&quot;:false,&quot;arrowsPosition&quot;:&quot;bottom-right&quot;,&quot;navColor&quot;:&quot;#123456&quot;,&quot;navColorOnHover&quot;:true,&quot;navPlacement&quot;:&quot;outside&quot;,&quot;trackActiveSlide&quot;:false,&quot;transitionEffect&quot;:&quot;flip&quot;,&quot;autoHeight&quot;:true}"><button class="gallery-lightbox-trigger" type="button" aria-label="A photo +1" style="aspect-ratio: 10/20;"><img src="a.jpg" alt="A photo" width="10" height="20" loading="eager" decoding="async"><span class="gallery-lightbox-count" aria-hidden="true">+1</span></button></div>"`;

