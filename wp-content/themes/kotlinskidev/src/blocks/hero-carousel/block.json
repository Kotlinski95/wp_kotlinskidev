{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/hero-carousel",
  "version": "1.0.0",
  "title": "Hero Carousel",
  "category": "media",
  "icon": "images-alt2",
  "textdomain": "kotlinskidev",
  "render": "file:./render.php",
  "editorScript": "file:../../../build/hero-carousel.js",
  "viewScript": "file:../../../build/hero-carousel-init.js",
  "style": "file:../../../build/style-hero-carousel.css",
  "viewStyle": "file:../../../build/hero-carousel-init.css",
  "supports": {
    "align": ["full", "wide"],
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "providesContext": {
    "kotlinskidev/lazyLoad": "lazyLoad"
  },
  "attributes": {
    "minHeight": { "type": "number", "default": 80 },
    "showArrows": { "type": "boolean", "default": true },
    "showPagination": { "type": "boolean", "default": true },
    "loop": { "type": "boolean", "default": true },
    "draggable": { "type": "boolean", "default": true },
    "autoplay": { "type": "boolean", "default": false },
    "autoplayDelay": { "type": "number", "default": 5000 },
    "lazyLoad": { "type": "boolean", "default": false },
    "arrowsPosition": { "type": "string", "default": "sides" },
    "navColor": { "type": "string", "default": "" },
    "navColorOnHover": { "type": "boolean", "default": false },
    "navPlacement": { "type": "string", "default": "inside" },
    "transitionEffect": { "type": "string", "default": "slide" }
  }
}
