{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/nav-language-panel",
  "version": "1.0.0",
  "title": "Language Panel",
  "category": "kotlinskidev-navigation",
  "icon": "translation",
  "description": "Language switcher trigger with dropdown panel. Place inside a navigation block.",
  "textdomain": "kotlinskidev",
  "parent": ["core/navigation"],
  "editorScript": "file:../../../build/language-panel.js",
  "render": "file:./render.php",
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "labelStyle": {
      "type": "string",
      "default": "short"
    },
    "showFlag": {
      "type": "boolean",
      "default": true
    },
    "navIconId": {
      "type": "integer",
      "default": 0
    },
    "navIconUrl": {
      "type": "string",
      "default": ""
    },
    "visibility": {
      "type": "string",
      "default": "both"
    },
    "showIndicator": {
      "type": "boolean",
      "default": true
    },
    "indicatorIconId": {
      "type": "integer",
      "default": 0
    },
    "indicatorIconUrl": {
      "type": "string",
      "default": ""
    },
    "indicatorEffect": {
      "type": "string",
      "default": "rotate"
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false,
    "color": {
      "text": true,
      "background": false
    },
    "spacing": false,
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    }
  }
}
