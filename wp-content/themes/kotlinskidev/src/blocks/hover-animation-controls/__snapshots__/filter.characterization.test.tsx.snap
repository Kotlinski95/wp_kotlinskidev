    "attributes": "zoomRadius",
    "block": "kotlinskidev/certificate",
    "markup": "<div data-testid="original"></div><div class="components-panel__body is-opened"><h2 class="components-panel__body-title"><button type="button" aria-expanded="true" class="components-button components-panel__body-toggle is-next-40px-default-size"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24" class="components-panel__arrow" aria-hidden="true" focusable="false"><path d="M6.5 12.4L12 8l5.5 4.4-.9 1.2L12 10l-4.5 3.6-1-1.2z"></path></svg></span>Hover Effects<span class="dashicon dashicons dashicons-art components-panel__icon"></span></button></h2><div class="_94dff8a2f7c49fc8__wrapper components-base-control components-select-control"><div class="d9ac8e2c0db95cc7__field components-base-control__field"><div data-wp-c16t="true" data-wp-component="InputBase" class="e518617e7c3a18e7__flex f9694ed4faabfc82__items-column components-flex components-input-base e1mv6sxx3 css-1kjjl8q-Root-StyledInputBase em5sgkm5" style="--wp-components-flex-align: normal; --wp-components-flex-direction: column; --wp-components-flex-wrap: nowrap; --wp-components-flex-gap: calc(4px * 2); --wp-components-flex-justify: space-between;"><div data-wp-c16t="true" data-wp-component="FlexItem" class="bc09d0edcc10c304__item components-flex-item css-nrhbmn-LabelWrapper em5sgkm1" style="--wp-components-flex-item-display: block;"><label data-wp-c16t="true" data-wp-component="Text" for="inspector-select-control-42" class="components-truncate css-tf28v4-Text-base-textStyles components-text components-input-control__label css-w5emdr-BaseLabel-baseLabelTypography em5sgkm2">Animation Type</label></div><div class="components-input-control__container css-f1w127-Container-containerDisabledStyles-containerWidthStyles em5sgkm4"><select aria-describedby="inspector-select-control-42__help" class="components-select-control__input css-1ulocc7-Select-fontSizeStyles-sizeStyles-rtl e1mv6sxx2" id="inspector-select-control-42"><option