{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/feature-card-canvas",
  "version": "1.0.0",
  "title": "Feature Card Canvas",
  "category": "kotlinskidev",
  "icon": "block-default",
  "description": "Animated, palette-driven illustration rendered on a canvas for feature cards.",
  "textdomain": "kotlinskidev",
  "render": "file:./render.php",
  "editorScript": "file:../../../build/js/feature-card-canvas.js",
  "viewScript": "file:../../../build/js/feature-card-canvas-init.js",
  "style": "file:../../../build/css/style-feature-card-canvas.css",
  "supports": {
    "html": false,
    "reusable": false,
    "spacing": { "margin": true }
  },
  "attributes": {
    "variant": {
      "type": "string",
      "default": "browser-stream",
      "enum": [
        "browser-stream",
        "node-tree",
        "dot-image-stack",
        "chart-growth",
        "storefront",
        "layout-builder",
        "speed-gauge",
        "nav-about",
        "nav-projects",
        "nav-services",
        "nav-contact",
        "site-scroll",
        "checkout-flow",
        "app-dashboard",
        "load-waterfall",
        "local-search",
        "support-shield",
        "benefit-marketing",
        "benefit-saas",
        "benefit-design-system",
        "benefit-api",
        "commerce-conversion",
        "commerce-scale",
        "commerce-secure",
        "commerce-platforms",
        "illus-storefront",
        "illus-audit",
        "illus-mobile-first",
        "illus-vitals",
        "illus-mobile-checkout",
        "illus-seo-growth",
        "illus-handover",
        "illus-app-services",
        "vs-frameworks",
        "pwa-install",
        "ssr-smartedit",
        "nextjs-architecture",
        "perf-by-design",
        "smart-shopping-list",
        "wp-custom-theme",
        "wp-stack-ownership",
        "wp-flex-control"
      ]
    },
    "aspectRatio": { "type": "string", "default": "16/10" },
    "labelOne": { "type": "string", "default": "" },
    "labelTwo": { "type": "string", "default": "" },
    "labelThree": { "type": "string", "default": "" },
    "description": { "type": "string", "default": "" },
    "accentColor": { "type": "string", "default": "" },
    "touchAutoplay": { "type": "boolean", "default": true },
    "trigger": { "type": "string", "default": "hover", "enum": ["hover", "in-view"] }
  }
}
