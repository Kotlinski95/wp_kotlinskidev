{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/banner-carousel",
  "version": "1.0.0",
  "title": "Banner Carousel",
  "category": "media",
  "icon": "images-alt2",
  "textdomain": "kotlinskidev",
  "editorScript": "file:../../../build/banner-carousel.js",
  "viewScript": "file:../../../build/banner-carousel-init.js",
  "style": "file:../../../build/style-banner-carousel.css",
  "viewStyle": "file:../../../build/banner-carousel-init.css",
  "attributes": {
    "images": { "type": "array", "default": [] },
    "showArrows": { "type": "boolean", "default": true },
    "showPagination": { "type": "boolean", "default": true },
    "showScrollbar": { "type": "boolean", "default": false },
    "loop": { "type": "boolean", "default": false },
    "draggable": { "type": "boolean", "default": true },
    "autoplay": { "type": "boolean", "default": false },
    "autoplayDelay": { "type": "number", "default": 3000 },
    "lazyLoad": { "type": "boolean", "default": false },
    "arrowsPosition": { "type": "string", "default": "sides" },
    "navColor": { "type": "string", "default": "" },
    "navPlacement": { "type": "string", "default": "inside" },
    "slidesPerView": { "type": ["number", "string"], "default": 1 },
    "slidesPerMobile": { "type": ["number", "string"], "default": 1 },
    "slidesPerTablet": { "type": ["number", "string"], "default": 1 },
    "slidesPerDesktop": { "type": ["number", "string"], "default": 1 },
    "transitionEffect": { "type": "string", "default": "slide" }
  }
}
