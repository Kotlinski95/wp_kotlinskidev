{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/popular-pages",
  "version": "1.0.0",
  "title": "Popular Pages",
  "category": "kotlinskidev",
  "icon": "chart-bar",
  "description": "Compact list of most-visited pages, sorted by internal page-view count.",
  "textdomain": "kotlinskidev",
  "editorScript": "file:../../../build/js/popular-pages.js",
  "render": "file:./render.php",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Popular Pages"
    },
    "count": {
      "type": "integer",
      "default": 5
    },
    "titleFontSize": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": false
    },
    "spacing": false,
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    }
  }
}
