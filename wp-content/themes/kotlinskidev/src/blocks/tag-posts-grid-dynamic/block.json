{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/tag-posts-grid-dynamic",
  "version": "1.0.0",
  "title": "Tag Posts Grid (Dynamic)",
  "category": "kotlinskidev",
  "description": "Server-rendered grid of posts within the current tag archive.",
  "icon": "list-view",
  "textdomain": "kotlinskidev",
  "render": "file:./render.php",
  "editorScript": "file:../../../build/js/tag-posts-grid-dynamic.js",
  "attributes": {
    "cardHoverBackgroundColor": { "type": "string", "default": "" },
    "blurOtherCards": { "type": "boolean", "default": false },
    "blurAmount": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}
