{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/marquee-item",
  "version": "1.0.0",
  "title": "Marquee Item",
  "category": "layout",
  "icon": "admin-generic",
  "description": "Single technology/skill entry in a Marquee — holds any block content and optionally opens a Modal post on click.",
  "textdomain": "kotlinskidev",
  "render": "file:./render.php",
  "parent": ["kotlinskidev/marquee"],
  "supports": {
    "inserter": false,
    "reusable": false,
    "html": false
  },
  "attributes": {
    "modalId": {
      "type": "number",
      "default": 0
    }
  }
}
