{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kotlinskidev/scroll-section",
  "version": "1.0.0",
  "title": "Scroll Section",
  "category": "layout",
  "description": "Sticky horizontal-scroll section — vertical scroll drives horizontal pan through items.",
  "icon": "leftright",
  "textdomain": "kotlinskidev",
  "render": "file:./render.php",
  "editorScript": "file:../../../build/scroll-section.js",
  "viewScript": "file:../../../build/scroll-section-init.js",
  "style": "file:../../../build/style-scroll-section.css",
  "supports": {
    "align": ["full", "wide"],
    "anchor": true,
    "spacing": {
      "padding": true,
      "margin": ["top", "bottom"],
      "blockGap": false
    },
    "dimensions": {
      "minHeight": true
    }
  },
  "attributes": {
    "trigger": {
      "type": "string",
      "default": "center"
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "markers": {
      "type": "boolean",
      "default": false
    },
    "slideWidth": {
      "type": "string",
      "enum": ["auto", "full"],
      "default": "auto"
    }
  }
}
