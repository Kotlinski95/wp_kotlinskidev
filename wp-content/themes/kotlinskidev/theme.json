{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1420px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "customDuotone": true,
      "link": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#8209d3",
          "name": "Primary"
        },
        {
          "slug": "primary-rgb",
          "color": "59, 130, 246",
          "name": "Primary RGB"
        },
        {
          "slug": "primary-hover",
          "color": "#6a11cb",
          "name": "Primary"
        },
        {
          "slug": "primary-shade-1",
          "color": "#8209d3",
          "name": "Primary Shade 1"
        },
        {
          "slug": "primary-shade-2",
          "color": "#8209d3",
          "name": "Primary Shade 2"
        },
        {
          "slug": "contrast",
          "color": "#000000",
          "name": "Contrast"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "light-color",
          "color": "#f2f2f2",
          "name": "Light Color"
        },
        {
          "slug": "dark-color",
          "color": "#191919",
          "name": "Dark Color"
        },
        {
          "slug": "dark-shade",
          "color": "#191919",
          "name": "Dark Shade"
        },
        {
          "slug": "transparent-shade",
          "color": "#19191900",
          "name": "Transparent Shade"
        }
      ],
      "duotone": [],
      "gradients": [
        {
          "gradient": "linear-gradient(to right, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--contrast)  51%, var(--wp--preset--color--primary)  100%)",
          "name": "Gradient 1",
          "slug": "gradient-one"
        },
        {
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0, rgba(var(--wp--preset--color--primary-rgb, 59, 130, 246), .8) 100%)",
          "name": "Gradient 2",
          "slug": "gradient-two"
        },
        {
          "gradient": "radial-gradient(100% 53.32% at 50% 125%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block bottom",
          "slug": "gradient-block-bottom"
        },
        {
          "gradient": "radial-gradient(100% 53.32% at 50% -25%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top",
          "slug": "gradient-block-top"
        },
        {
          "gradient": "radial-gradient(15.38% 51.96% at -5% 50%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block left",
          "slug": "gradient-block-left"
        },
        {
          "gradient": "radial-gradient(15.38% 51.96% at 105% 50%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block right",
          "slug": "gradient-block-right"
        },
        {
          "gradient": "radial-gradient(30.83% 47.59% at 100% 0%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-top-right"
        },
        {
          "gradient": "radial-gradient(30.83% 47.59% at 0% 0%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-top-left"
        },
        {
          "gradient": "radial-gradient(30.83% 47.59% at 0% 100%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-bottom-left"
        },
        {
          "gradient": "radial-gradient(30.83% 47.59% at 100% 100%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-bottom-right"
        }
      ]
    },
    "shadow": {
      "presets": [
        {
          "name": "Natural",
          "slug": "natural",
          "shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)"
        },
        {
          "name": "Hover Jump Shadow",
          "slug": "hover-jump",
          "shadow": "0 15px 30px rgba(0, 0, 0, 0.15)"
        },
        {
          "name": "Primary Shadow",
          "slug": "primary",
          "shadow": "0 8px 25px rgba(130, 9, 211, 0.15)"
        },
        {
          "name": "Primary Glow",
          "slug": "primary-glow",
          "shadow": "0 0 20px rgba(130, 9, 211, 0.3), 0 4px 8px rgba(0, 0, 0, 0.1)"
        },
        {
          "name": "Primary Dynamic",
          "slug": "primary-dynamic",
          "shadow": "0 6px 20px rgba(var(--wp--preset--color--primary-rgb, 59, 130, 246), .3), 0 2px 4px rgba(0, 0, 0, .1)"
        },
        {
          "name": "Soft Elevation",
          "slug": "soft-elevation",
          "shadow": "0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)"
        },
        {
          "name": "Medium Elevation",
          "slug": "medium-elevation",
          "shadow": "0 3px 6px rgba(0, 0, 0, 0.16), 0 3px 6px rgba(0, 0, 0, 0.23)"
        },
        {
          "name": "High Elevation",
          "slug": "high-elevation",
          "shadow": "0 10px 20px rgba(0, 0, 0, 0.19), 0 6px 6px rgba(0, 0, 0, 0.23)"
        },
        {
          "name": "Dramatic",
          "slug": "dramatic",
          "shadow": "0 14px 28px rgba(0, 0, 0, 0.25), 0 10px 10px rgba(0, 0, 0, 0.22)"
        },
        {
          "name": "Inner Glow",
          "slug": "inner-glow",
          "shadow": "inset 0 0 10px rgba(130, 9, 211, 0.2)"
        },
        {
          "name": "Colored Drop",
          "slug": "colored-drop",
          "shadow": "0 8px 16px rgba(25, 25, 25, 0.15), 0 4px 8px rgba(130, 9, 211, 0.1)"
        }
      ]
    },
    "custom": {
      "typography": {
        "line-height": {
          "tiny": 1.15,
          "small": 1.2,
          "medium": 1.4,
          "normal": 1.6
        }
      }
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "typography": {
      "dropCap": false,
      "fluid": true,
      "lineHeight": true,
      "customFontSize": true,
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "12px",
          "name": "Extra Small"
        },
        {
          "slug": "small",
          "size": "14px",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "16px",
          "name": "Normal"
        },
        {
          "slug": "medium",
          "size": "20px",
          "name": "Medium"
        },
        {
          "slug": "big",
          "size": "24px",
          "name": "big"
        },
        {
          "slug": "large",
          "size": "32px",
          "name": "Extra Large"
        },
        {
          "slug": "x-large",
          "size": "40px",
          "name": "Double Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "48px",
          "name": "Big Large"
        },
        {
          "slug": "xxx-large",
          "size": "64px",
          "name": "Big Large"
        }
      ],
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Sora, Arial, sans-serif",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/sora/Sora-VariableFont_wght.woff2"]
            }
          ],
          "fontFamily": "\"Sora\", sans-serif",
          "name": "Sora",
          "slug": "sora"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "\"Sora\", sans-serif",
      "fontSize": "var(--wp-preset--font-size--normal)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--secondary)"
          }
        }
      },
      "button": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "var(--wp--preset--font-weight--bold)",
          "lineHeight": "var(--wp--preset--line-height--initial)"
        },
        "border": {
          "radius": "0.375em",
          "color": "var(--wp--preset--color--tertiary)"
        },
        ":hover": {
          "background": {
            "backgroundPosition": "right center"
          }
        }
      },

      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--preset--line-height--normal)"
        },
        "spacing": {
          "margin": {
            "bottom": "var(--wp--preset--spacing--small)"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--preset--line-height--normal)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--medium)",
            "bottom": "var(--wp--preset--spacing--x-small)"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--preset--line-height--x-small)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--medium)",
            "bottom": "var(--wp--preset--spacing--x-small)"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600",
          "lineHeight": "var(--wp--preset--line-height--x-small)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--small)",
            "bottom": "var(--wp--preset--spacing--xx-small)"
          }
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "var(--wp--preset--font-weight--semi-bold)",
          "lineHeight": "var(--wp--preset--line-height--medium)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--small)",
            "bottom": "var(--wp--preset--spacing--xx-small)"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--x-small)",
            "bottom": "var(--wp--preset--spacing--xx-small)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontStyle": "normal",
          "fontWeight": "var(--wp--preset--font-weight--semi-bold)",
          "lineHeight": "1.5"
        }
      }
    },
    "color": {},
    "blocks": {
      "core/details": {
        "border": {
          "width": "1px",
          "style": "solid",
          "color": "#ccc"
        }
      }
    }
  }
}
