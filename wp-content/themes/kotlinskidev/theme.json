{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "73.75rem",
      "wideSize": "88.75rem"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "customDuotone": true,
      "link": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#8209d3",
          "name": "Primary"
        },
        {
          "slug": "primary-rgb",
          "color": "130, 9, 211",
          "name": "Primary RGB"
        },
        {
          "slug": "primary-hover",
          "color": "#6a11cb",
          "name": "Primary"
        },
        {
          "slug": "primary-shade-1",
          "color": "#8209d3",
