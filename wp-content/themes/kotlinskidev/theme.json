          "name": "Surface · Light Mode"
        },
        {
          "slug": "surface-dark",
          "color": "#191919",
          "name": "Surface · Dark Mode"
        },
        {
          "slug": "foreground-light",
          "color": "#191919",
          "name": "Foreground · Light Mode"
        },
        {
          "slug": "foreground-dark",
          "color": "#f2f2f2",
          "name": "Foreground · Dark Mode"
        },
        {
          "slug": "foreground-alt-light",
          "color": "#4a4a4a",
          "name": "Foreground Alt · Light Mode"
        },
        {
          "slug": "foreground-alt-dark",
          "color": "#b8b8b8",
          "name": "Foreground Alt · Dark Mode"
        },
        {
          "slug": "divider-light",
          "color": "#d9d9d9",
          "name": "Divider · Light Mode"
        },
        {
          "slug": "divider-dark",
          "color": "#2e2e2e",
          "name": "Divider · Dark Mode"
        },
        {
          "slug": "surface",
          "color": "light-dark(var(--wp--preset--color--surface-light), var(--wp--preset--color--surface-dark))",
          "name": "Surface (Adaptive)"
        },
        {
          "slug": "foreground",
          "color": "light-dark(var(--wp--preset--color--foreground-light), var(--wp--preset--color--foreground-dark))",
          "name": "Foreground (Adaptive)"
        },
        {
          "slug": "foreground-alt",
          "color": "light-dark(var(--wp--preset--color--foreground-alt-light), var(--wp--preset--color--foreground-alt-dark))",
          "name": "Foreground Alt (Adaptive)"
        },
        {
          "slug": "foreground-contrast",
          "color": "light-dark(var(--wp--preset--color--foreground-dark), var(--wp--preset--color--foreground-light))",
          "name": "Foreground Contrast (Adaptive)"
        },
        {
          "slug": "divider",
          "color": "light-dark(var(--wp--preset--color--divider-light), var(--wp--preset--color--divider-dark))",
          "name": "Divider (Adaptive)"
        }
      ],
      "duotone": [],
      "gradients": [
        {
          "gradient": "linear-gradient(to left, rgb(184, 150, 255) 0%, rgb(0, 246, 255) 60%, rgb(0, 255, 240) 100%)",
          "name": "Link & Text Gradient — Dark Mode",
          "slug": "fancy-text-dark"
        },
        {
          "gradient": "linear-gradient(to left, rgb(132, 83, 210) 0%, rgb(0, 71, 255) 60%, rgb(0, 120, 194) 100%)",
          "name": "Link & Text Gradient — Light Mode",
          "slug": "fancy-text-light"
        },
        {
          "gradient": "linear-gradient(to left, light-dark(rgb(132, 83, 210), rgb(184, 150, 255)) 0%, light-dark(rgb(0, 71, 255), rgb(0, 246, 255)) 60%, light-dark(rgb(0, 120, 194), rgb(0, 255, 240)) 100%)",
          "name": "Link & Text Gradient (Adaptive)",
          "slug": "fancy-text"
        },
        {
          "gradient": "linear-gradient(to right, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--contrast)  51%, var(--wp--preset--color--primary)  100%)",
          "name": "Gradient 1",
          "slug": "gradient-one"
        },
        {
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0, rgba(var(--wp--preset--color--primary-rgb, 59, 130, 246), .8) 100%)",
          "name": "Gradient 2",
          "slug": "gradient-two"
        },
        {
          "gradient": "radial-gradient(100% 53.32% at 50% 125%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block bottom",
          "slug": "gradient-block-bottom"
        },
        {
          "gradient": "radial-gradient(100% 53.32% at 50% -25%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top",
          "slug": "gradient-block-top"
        },
        {
          "gradient": "radial-gradient(15.38% 51.96% at -5% 50%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 12%, var(--wp--preset--color--primary-shade-2) 44%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block left",
          "slug": "gradient-block-left"
        },
        {
          "gradient": "radial-gradient(15.38% 51.96% at 105% 50%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 1%, var(--wp--preset--color--primary-shade-2) 1%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block right",
          "slug": "gradient-block-right"
        },
        {
          "gradient": "radial-gradient(30.83% 23.59% at 100% 0%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 1%, var(--wp--preset--color--primary-shade-2) 1%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-top-right"
        },
        {
          "gradient": "radial-gradient(30.83% 23.59% at 0% 0%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 1%, var(--wp--preset--color--primary-shade-2) 1%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-top-left"
        },
        {
          "gradient": "radial-gradient(30.83% 23.59% at 0% 100%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 1%, var(--wp--preset--color--primary-shade-2) 1%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-bottom-left"
        },
        {
          "gradient": "radial-gradient(30.83% 23.59% at 100% 100%, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-shade-1) 1%, var(--wp--preset--color--primary-shade-2) 1%, var(--wp--preset--color--transparent-shade) 100%)",
          "name": "Gradient block top right",
          "slug": "gradient-block-bottom-right"
        },
        {
          "gradient": "linear-gradient(to right, #00ffd3 15%, #00f6ff 50%, #b896ff 90%)",
          "name": "Cyber Accent",
          "slug": "cyber-accent"
        }
      ]
    },
    "shadow": {
      "presets": [
        {
          "name": "Natural",
          "slug": "natural",
          "shadow": "0 0.25rem 0.375rem -0.0625rem rgba(0, 0, 0, 0.1), 0 0.125rem 0.25rem -0.0625rem rgba(0, 0, 0, 0.06)"
        },
        {
          "name": "Hover Jump Shadow",
          "slug": "hover-jump",
          "shadow": "0 0.9375rem 1.875rem rgba(0, 0, 0, 0.15)"
        },
        {
          "name": "Primary Shadow",
          "slug": "primary",
          "shadow": "0 0.5rem 1.5625rem rgba(130, 9, 211, 0.15)"
        },
        {
          "name": "Primary Glow",
          "slug": "primary-glow",
          "shadow": "0 0 1.25rem rgba(130, 9, 211, 0.3), 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1)"
        },
        {
          "name": "Primary Dynamic",
          "slug": "primary-dynamic",
          "shadow": "0 0.375rem 1.25rem rgba(var(--wp--preset--color--primary-rgb, 59, 130, 246), .3), 0 0.125rem 0.25rem rgba(0, 0, 0, .1)"
        },
        {
          "name": "Soft Elevation",
          "slug": "soft-elevation",
          "shadow": "0 0.0625rem 0.1875rem rgba(0, 0, 0, 0.12), 0 0.0625rem 0.125rem rgba(0, 0, 0, 0.24)"
        },
        {
          "name": "Medium Elevation",
          "slug": "medium-elevation",
          "shadow": "0 0.1875rem 0.375rem rgba(0, 0, 0, 0.16), 0 0.1875rem 0.375rem rgba(0, 0, 0, 0.23)"
        },
        {
          "name": "High Elevation",
          "slug": "high-elevation",
          "shadow": "0 0.625rem 1.25rem rgba(0, 0, 0, 0.19), 0 0.375rem 0.375rem rgba(0, 0, 0, 0.23)"
        },
        {
          "name": "Dramatic",
          "slug": "dramatic",
          "shadow": "0 0.875rem 1.75rem rgba(0, 0, 0, 0.25), 0 0.625rem 0.625rem rgba(0, 0, 0, 0.22)"
        },
        {
          "name": "Inner Glow",
          "slug": "inner-glow",
          "shadow": "inset 0 0 0.625rem rgba(130, 9, 211, 0.2)"
        },
        {
          "name": "Colored Drop",
          "slug": "colored-drop",
          "shadow": "0 0.5rem 1rem rgba(25, 25, 25, 0.15), 0 0.25rem 0.5rem rgba(130, 9, 211, 0.1)"
        }
      ]
    },
    "custom": {
      "typography": {
        "line-height": {
          "tiny": 1.15,
          "small": 1.2,
          "medium": 1.4,
          "normal": 1.6
        }
      },
      "textShadow": {
        "adaptive": "0 0 0.5rem currentColor",
        "adaptive-subtle": "0 0 0.25rem color-mix(in srgb, currentColor 40%, transparent)",
        "adaptive-strong": "0 0 0.5rem currentColor, 0 0 1rem color-mix(in srgb, currentColor 60%, transparent)",
        "adaptive-contrast": "0 0 0.5rem var(--wp--preset--color--foreground-contrast)",
        "adaptive-contrast-subtle": "0 0 0.25rem color-mix(in srgb, var(--wp--preset--color--foreground-contrast) 40%, transparent)",
        "adaptive-contrast-strong": "0 0 0.5rem var(--wp--preset--color--foreground-contrast), 0 0 1rem color-mix(in srgb, var(--wp--preset--color--foreground-contrast) 60%, transparent)",
        "light-subtle": "0 0 0.25rem color-mix(in srgb, var(--wp--preset--color--foreground-light) 40%, transparent)",
        "light-strong": "0 0 0.5rem var(--wp--preset--color--foreground-light), 0 0 1rem color-mix(in srgb, var(--wp--preset--color--foreground-light) 60%, transparent)",
        "dark-subtle": "0 0 0.25rem color-mix(in srgb, var(--wp--preset--color--foreground-dark) 40%, transparent)",
        "dark-strong": "0 0 0.5rem var(--wp--preset--color--foreground-dark), 0 0 1rem color-mix(in srgb, var(--wp--preset--color--foreground-dark) 60%, transparent)",
        "subtle": "0 0.0625rem 0.125rem rgba(0, 0, 0, 0.25)",
        "soft-glow": "0 0 0.5rem rgba(130, 9, 211, 0.5)",
        "primary-glow": "0 0 0.75rem rgba(130, 9, 211, 0.6)",
        "strong": "0.125rem 0.125rem 0.25rem rgba(0, 0, 0, 0.45)",
        "outline-pop": "0.0625rem 0.0625rem 0 rgba(0, 0, 0, 0.85)"
      }
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "typography": {
      "dropCap": false,
      "fluid": true,
      "lineHeight": true,
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true,
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "0.75rem",
          "name": "Extra Small"
        },
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "1rem",
          "name": "Normal"
        },
        {
          "slug": "medium",
          "size": "1.25rem",
          "name": "Medium"
        },
        {
          "slug": "big",
          "size": "1.5rem",
          "name": "big"
        },
        {
          "slug": "large",
          "size": "2rem",
          "name": "Extra Large"
        },
        {
          "slug": "x-large",
          "size": "2.5rem",
          "name": "Double Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "3rem",
          "name": "Big Large"
        },
        {
          "slug": "xxx-large",
          "size": "4rem",
          "name": "Big Large"
        }
      ],
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Sora, Arial, sans-serif",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/sora/Sora-VariableFont_wght.woff2"]
            }
          ],
          "fontFamily": "\"Sora\", sans-serif",
          "name": "Sora",
          "slug": "sora"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "\"Sora\", sans-serif",
      "fontSize": "var(--wp-preset--font-size--normal)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--secondary)"
          }
        }
      },
      "button": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "var(--wp--preset--font-weight--bold)",
          "lineHeight": "var(--wp--preset--line-height--initial)"
        },
        "border": {
          "radius": "0.375em",
          "color": "var(--wp--preset--color--tertiary)"
        },
        ":hover": {
          "background": {
            "backgroundPosition": "right center"
          }
        }
      },

      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--preset--line-height--normal)"
        },
        "spacing": {
          "margin": {
            "bottom": "var(--wp--preset--spacing--small)"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--preset--line-height--normal)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--medium)",
            "bottom": "var(--wp--preset--spacing--x-small)"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--preset--line-height--x-small)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--medium)",
            "bottom": "var(--wp--preset--spacing--x-small)"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600",
          "lineHeight": "var(--wp--preset--line-height--x-small)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--small)",
            "bottom": "var(--wp--preset--spacing--xx-small)"
          }
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "var(--wp--preset--font-weight--semi-bold)",
          "lineHeight": "var(--wp--preset--line-height--medium)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--small)",
            "bottom": "var(--wp--preset--spacing--xx-small)"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--x-small)",
            "bottom": "var(--wp--preset--spacing--xx-small)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontStyle": "normal",
          "fontWeight": "var(--wp--preset--font-weight--semi-bold)",
          "lineHeight": "1.5"
        }
      }
    },
    "color": {},
    "blocks": {
      "core/details": {
        "border": {
          "width": "0.0625rem",
          "style": "solid",
          "color": "#ccc"
        }
      }
    }
  }
}
