        "dark-subtle": "0 0 0.25rem color-mix(in srgb, var(--wp--preset--color--foreground-dark) 40%, transparent)",
        "dark-strong": "0 0 0.5rem var(--wp--preset--color--foreground-dark), 0 0 1rem color-mix(in srgb, var(--wp--preset--color--foreground-dark) 60%, transparent)",
        "subtle": "0 0.0625rem 0.125rem rgba(0, 0, 0, 0.25)",
        "soft-glow": "0 0 0.5rem rgba(130, 9, 211, 0.5)",
        "primary-glow": "0 0 0.75rem rgba(130, 9, 211, 0.6)",
        "strong": "0.125rem 0.125rem 0.25rem rgba(0, 0, 0, 0.45)",
