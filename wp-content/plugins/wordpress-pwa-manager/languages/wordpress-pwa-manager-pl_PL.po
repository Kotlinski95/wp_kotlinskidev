#: includes/class-pwa-frontend.php:33
msgid "Try Again"
msgstr "Spróbuj ponownie"

#: wordpress-pwa-manager.php:101
msgid "Install App"
msgstr "Zainstaluj Kotlinskidev"

#: wordpress-pwa-manager.php:102
msgid ""
"Install this app on your device for a better experience and quick access."
msgstr ""
"Zainstaluj tę aplikację na swoim urządzeniu, aby uzyskać lepsze wrażenia i "
"szybki dostęp."

#: wordpress-pwa-manager.php:103
msgid "Install"
msgstr "Zainstaluj"

#: wordpress-pwa-manager.php:104
msgid "Ask me later"
msgstr "Zapytaj mnie później"

#: wordpress-pwa-manager.php:105
msgid "No thanks"
msgstr "Nie, dziękuję"

#: wordpress-pwa-manager.php:108
msgid "Update Available"
msgstr "Dostępna aktualizacja"

#: wordpress-pwa-manager.php:109
msgid ""
"A new version of this app is available. Update now for the latest features "
"and improvements."
msgstr ""
"Dostępna jest nowa wersja tej aplikacji. Zaktualizuj teraz, aby uzyskać "
"najnowsze funkcje i ulepszenia."

#: wordpress-pwa-manager.php:110
msgid "Update Now"
msgstr "Zaktualizuj teraz"

#: wordpress-pwa-manager.php:111
msgid "Later"
msgstr "Później"

#: wordpress-pwa-manager.php:114
msgid "Back online"
msgstr "Połączenie przywrócone"

#: wordpress-pwa-manager.php:115
msgid "You are offline"
msgstr "Jesteś offline"
